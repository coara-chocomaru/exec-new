<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Button
        android:id="@+id/btn_genkey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0. Generate ADB Key Pair" />

    <Button
        android:id="@+id/btn_bind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Bind to ProxyService" />

    <TextView
        android:id="@+id/tv_port"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Proxy Port: N/A"
        android:paddingTop="8dp" />

    <EditText
        android:id="@+id/et_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="127.0.0.1:5555"
        android:hint="Target Host:Port (e.g., 127.0.0.1:4444)" />

    <Button
        android:id="@+id/btn_tunnel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Establish Tunnel &amp; Authenticate"
        android:enabled="false" />

    <Button
        android:id="@+id/btn_scan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. Scan Internal Ports" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logs will appear here..."
            android:textSize="12sp"
            android:typeface="monospace" />
    </ScrollView>
</LinearLayout>
